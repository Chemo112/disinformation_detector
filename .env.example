# Copy this file to .env and fill in your keys. .env is git-ignored.

# Required: LLM provider used by all agents (https://console.groq.com/keys)
GROQ_API_KEY=

# Required: web search used by the fact-checking agent (https://app.tavily.com)
TAVILY_API_KEY=

# Optional: only if you select the claude-2 model
ANTHROPIC_API_KEY=

# Optional: LangSmith tracing of every agent call
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com/
# LANGCHAIN_API_KEY=
